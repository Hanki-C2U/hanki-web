generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("VITE_APP_URI")
}

model Mentee {
  id              Int            @id @default(autoincrement())
  first_name      String
  last_name       String
  age             Int            @default(20)
  gender          String         @default("Not specified")
  email           String         @unique
  phone_number    String         @unique
  password        String
  location        String
  updateAt        DateTime       @updatedAt
  last_login      DateTime       @default(now())
  ratings         Int            @default(0)
  profile_picture String         @default("https://nuxcfyhkrkiihdiztzcy.supabase.co/storage/v1/object/public/Project_Pics/anonymous.jpg")
  supabaseId      String         @unique
  bio             String
  joined          DateTime       @default(now())
  goals           String[]       @map("Interests")
  experience      Int            @default(0)
  Github          String?
  Instagram       String?
  LinkedIn        String?
  Twitter         String?
  Website         String?
  conversations   Conversation[]
  sessions        sessions[]
  mentor          Mentor[]       @relation("MenteeToMentor")

  @@map("mentee")
}

model Achievements {
  id         Int      @id @default(autoincrement())
  supabaseId String   @unique
  experience String[]
  education  String[]
  accolades  String[]
  reviews    String[]
  mentor     Mentor   @relation(fields: [supabaseId], references: [supabaseId])
}

model Mentor {
  id              Int            @id @default(autoincrement())
  first_name      String
  last_name       String
  age             Int            @default(20)
  email           String         @unique
  phone_number    String         @unique
  password        String
  supabaseId      String         @unique
  gender          String         @default("Not specified")
  profile_picture String         @default("https://nuxcfyhkrkiihdiztzcy.supabase.co/storage/v1/object/public/Project_Pics/anonymous.jpg")
  location        String
  joined          DateTime       @default(now())
  ratings         Int            @default(0)
  updateAt        DateTime       @updatedAt
  last_login      DateTime       @default(now())
  expertise       String[]
  bio             String         @map("Biography")
  experience      Int
  Github          String?
  Instagram       String?
  LinkedIn        String         @default("")
  Twitter         String?
  Website         String?
  achievement     Achievements?
  conversations   Conversation[]
  sessions        sessions[]
  mentee          Mentee[]       @relation("MenteeToMentor")

  @@map("mentor")
}

model Conversation {
  id          Int       @id @default(autoincrement())
  menteeId    String
  mentorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastMessage String?
  mentee      Mentee    @relation(fields: [menteeId], references: [supabaseId])
  mentor      Mentor    @relation(fields: [mentorId], references: [supabaseId])
  messages    Message[]

  @@unique([mentorId, menteeId])
  @@map("conversations")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderRole     String
  content        String
  createdAt      DateTime     @default(now())
  isRead         Boolean      @default(false)
  messageType    String       @default("text")
  senderId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model sessions {
  id                     Int           @id @default(autoincrement())
  menteeId               String
  mentorId               String
  title                  String
  description            String?
  startTime              String // e.g., "09:00", "14:30"
  endTime                String // e.g., "10:00", "15:30"
  sessionDate            DateTime // Date only
  jitsiRoomId            String        @unique
  meetingUrl             String?
  status                 SessionStatus @default(PENDING)
  statusUpdatedAt        DateTime      @default(now())
  statusUpdatedBy        String?
  additionalParticipants String[]      @default([])
  notes                  String?
  feedback               String?
  createdAt              DateTime      @default(now())
  cancellationReason     String?
  menteeRating           Int?
  menteeReview           String?
  mentorRating           Int?
  mentorReview           String?
  mentee                 Mentee        @relation(fields: [menteeId], references: [supabaseId])
  mentor                 Mentor        @relation(fields: [mentorId], references: [supabaseId])

  // Ensure only one session per time slot globally (across all mentors and mentees)
  @@unique([sessionDate, startTime])
  @@map("sessions")
}

enum SessionStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}
